{
  "name": "@opalx14/remoat-mcp",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Standalone MCP bridge for controlling Antigravity through CDP without coupling to Remoat core.",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:stdio": "bun run src/index.ts",
    "start:http": "bun run src/http.ts",
    "dev": "bun --watch run src/index.ts",
    "dev:http": "bun --watch run src/http.ts",
    "check:remote": "bun run scripts/check-remote.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "bun-types": "^1.2.18"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
